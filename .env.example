# Coinbase Developer Platform — https://portal.cdp.coinbase.com
CDP_API_KEY_ID=your_cdp_key_id_here
CDP_API_KEY_SECRET=your_cdp_key_secret_here
CDP_WALLET_SECRET=your_wallet_encryption_secret_here
# Leave blank on first run; then pin the printed address so the SAME wallet is
# reused across restarts (otherwise CDP mints a new wallet every time).
CDP_WALLET_ADDRESS=

# x402 server receiver (your agent wallet address on Base Sepolia)
X402_RECEIVER_ADDRESS=0xYourAgentWalletAddressHere
X402_SERVER_PORT=8402

# LLM
ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here   # alternative
LLM_MODEL=claude-sonnet-4-6

# Telegram — from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LangSmith observability
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=remesa-hackathon

# Demo safety
USE_MOCK_APIS=false   # set true to use hardcoded fallback data
MAX_TRANSFER_USD=10.0  # hard cap for testnet demo
